# Supabase Cloud Configuration
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-jwt-token"

# Canonical Site URL (Used for OAuth redirect callback URLs)
# Local development: http://localhost:3000
# Production deployment: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AI Studio runtime variables (optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
